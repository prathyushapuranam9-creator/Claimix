# Copy to .env.local (never commit real secrets)
DATABASE_URL=postgres://claimix:claimix_dev_password@localhost:5442/claimix
TEST_DATABASE_URL=postgres://claimix:claimix_dev_password@localhost:5442/claimix_test
E2E_DATABASE_URL=postgres://claimix:claimix_dev_password@localhost:5442/claimix_e2e
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
LLM_ASSISTANT_ENABLED=false
# Set LLM_ASSISTANT_ENABLED=true and fill the key to let the assistant reword answers via OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Tests only: password for the fictional fixture accounts in the integration/E2E test databases.
SEED_DEMO_PASSWORD=choose-a-test-password-12+chars
TRUSTED_PROXY_HOPS=1

# Optional: passwords for the three shared demo logins created by `npm run demo:accounts`
# (admin@claimix.com, insurer@claimix.com, hospital@claimix.com). Development only.
DEMO_ADMIN_PASSWORD=
DEMO_INSURER_PASSWORD=
DEMO_HOSPITAL_PASSWORD=
